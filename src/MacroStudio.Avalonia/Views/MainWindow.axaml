<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="MacroStudio.Avalonia.Views.MainWindow"
		Title="Macro Studio"
		Width="1240"
		Height="860"
		MinWidth="980"
		MinHeight="700"
		Background="#0A1320">
	<TabControl Grid.Row="1" Margin="18" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
		<TabControl.ItemTemplate>
			<DataTemplate>
				<TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
			</DataTemplate>
		</TabControl.ItemTemplate>
	</TabControl>
</Window>